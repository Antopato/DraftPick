# Database connection URL (SQLAlchemy format).
# Dev default: SQLite file. For free Postgres (Neon/Supabase) just swap the URL:
#   postgresql+psycopg2://user:password@host/dbname
DATABASE_URL=sqlite:///./draftpick.db

# Comma-separated list of allowed CORS origins (the frontend URLs).
CORS_ORIGINS=http://localhost:5173
